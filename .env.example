# Copiez ce fichier en .env.local (développement) et renseignez les mêmes variables
# dans les réglages du projet Vercel (Settings > Environment Variables) pour la production.

# ─── Formulaire de devis : envoi des emails via Resend (https://resend.com) ───

# Clé API Resend (tableau de bord Resend > API Keys).
# Sans cette clé (ou sans DEVIS_TO_EMAIL), l'API répond 503 et le formulaire passe en mode secours :
# ouverture de la messagerie du visiteur si un email est renseigné dans src/config/site.ts,
# sinon message invitant à réessayer plus tard.
RESEND_API_KEY=

# Adresse qui reçoit les demandes de devis. Plusieurs adresses possibles, séparées par des virgules.
DEVIS_TO_EMAIL=

# Expéditeur des emails, sur un domaine vérifié dans Resend. Ex. : Netquoo <devis@netquoo.fr>
# Si vide : « Netquoo <onboarding@resend.dev> » (adresse de test Resend, qui ne peut envoyer
# qu'à l'adresse du compte Resend : à remplacer avant la mise en ligne).
DEVIS_FROM_EMAIL=

# ─── Site ───

# URL de production, sans slash final (balises canonical, sitemap, Open Graph). Ex. : https://www.netquoo.fr
NEXT_PUBLIC_SITE_URL=
